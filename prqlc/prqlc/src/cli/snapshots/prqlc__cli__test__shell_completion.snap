_prqlc() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="prqlc"
                ;;
            prqlc,collect)
                cmd="prqlc__subcmd__collect"
                ;;
            prqlc,compile)
                cmd="prqlc__subcmd__compile"
                ;;
            prqlc,debug)
                cmd="prqlc__subcmd__debug"
                ;;
            prqlc,experimental)
                cmd="prqlc__subcmd__experimental"
                ;;
            prqlc,fmt)
                cmd="prqlc__subcmd__fmt"
                ;;
            prqlc,help)
                cmd="prqlc__subcmd__help"
                ;;
            prqlc,lex)
