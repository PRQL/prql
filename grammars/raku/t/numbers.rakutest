use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 9;

# Integer
parses-to 'filter 123', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';

# Integer with underscore
parses-to 'filter 123_456', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';

# Integer with underscores
parses-to 'filter 123_456_789', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';

# Decimal
parses-to 'filter 123.45', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(float))))))))';

# Scientific notation
parses-to 'filter 123e10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer(integer)))))))))';

# Number with time unit
parses-to 'filter 5years', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(time-unit(number,dimension))))))))';

# Binary notation
parses-to 'filter 0b1111', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';

# Hex notation
parses-to 'filter 0xff', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';

# Octal notation
parses-to 'filter 0o777', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';
