use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 10;

# == Equals
parses-to 'filter foo == bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(identifier))))))))';

# != Not equals
parses-to 'filter foo != bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(identifier))))))))';

# >= Greater than or equal
parses-to 'filter foo >= bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(identifier))))))))';

# <= Less than or equal
parses-to 'filter foo <= bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(identifier))))))))';

# ~= Regex match
parses-to 'filter foo ~= bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(identifier))))))))';

# && And
parses-to 'filter foo && bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),logic-op,expression(identifier))))))))';

# || Or
parses-to 'filter foo || bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),logic-op,expression(identifier))))))))';

# ?? Coalesce
parses-to 'filter foo ?? bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),logic-op,expression(identifier))))))))';

# Unary operator -
parses-to 'sort { -name }', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(expression(unary-expression(expression(identifier)))))))))))';

# Unary operator ==
parses-to 'join customers (==customer_id)', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier))),test(test-inner(expression(parenthesized-expression(expression(unary-expression(identifier))))))))))';
