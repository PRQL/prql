use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 6;

# Plus
parses-to 'filter 10 + 10.5', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(float)))))))))';

# Minus
parses-to 'filter 10 - 10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(integer)))))))))';

# Multiply
parses-to 'filter 10 * 10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(integer)))))))))';

# Divide
parses-to 'filter 10 / 10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(integer)))))))))';

# Exponentiation
parses-to 'filter 10 ** 10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(integer)))))))))';

# Multiple ops. `binary-expression` accepts only an identifier on its left, so
# this doesn't nest: the shape records two arguments to `filter` — `10 + 10`
# and a unary `+ 10` — rather than one nested binary expression.
parses-to 'filter 10 + 10 + 10', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(number(integer)),arith-op,expression(number(integer))))),test(test-inner(expression(unary-expression(expression(number(integer))))))))))';
