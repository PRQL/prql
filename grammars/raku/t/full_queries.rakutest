use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 1;

# `pipeline` separates steps on `|` only, and a `rule` skips newlines like any
# other whitespace, so the newline-separated steps below are collected into the
# first `call-expression`'s argument list instead of becoming steps of their
# own. The shape records what the grammar builds today, not what it should.
parses-to q:to/END/, 'statement(comment«# Website showcasing example»),statement(pipeline-statement(pipeline(call-expression(identifier«from»,test(test-inner(expression(identifier«invoices»))),test(test-inner(expression(identifier«filter»))),test(test-inner(binary-test(expression(identifier«invoice_date»),compare-op«>=»,expression(date-time(date«1970-01-16»))))),test(test-inner(expression(identifier«derive»))),test(test-inner(expression(tuple-expression(declaration-tuple(identifier«transaction_fees»,expression(number(float«0.8»))),declaration-tuple(identifier«income»,expression(binary-expression(identifier«total»,arith-op«-»,expression(identifier«transaction_fees»)))))))),test(test-inner(expression(identifier«filter»))),test(test-inner(binary-test(expression(identifier«income»),compare-op«>»,expression(number(integer«1»))))),test(test-inner(expression(identifier«group»))),test(test-inner(expression(identifier«customer_id»))),test(test-inner(expression(nested-pipeline(pipeline(call-expression(identifier«aggregate»,test(test-inner(expression(tuple-expression(call-expression(identifier«average»,test(test-inner(expression(identifier«total»)))))))))))))),test(test-inner(expression(identifier«sort»))),test(test-inner(expression(tuple-expression(expression(unary-expression(expression(identifier«sum_income»))))))),test(test-inner(expression(identifier«take»))),test(test-inner(expression(number(integer«10»)))),test(test-inner(expression(identifier«join»))),declaration(identifier«c»,expression(identifier«customers»)),test(test-inner(expression(parenthesized-expression(expression(unary-expression(identifier«customer_id»)))))),test(test-inner(expression(identifier«derive»))),declaration(identifier«name»,expression(f-string«f"{c.last_name}, {c.first_name}"»)),test(test-inner(expression(identifier«select»))),test(test-inner(expression(tuple-expression(expression(identifier«c.customer_id»),expression(identifier«name»),expression(identifier«sum_income»))))),test(test-inner(expression(identifier«derive»))),declaration(identifier«db_version»,expression(s-string«s"version()"»))))))';
# Website showcasing example
from invoices
filter invoice_date >= @1970-01-16
derive {
  transaction_fees = 0.8,
  income = total - transaction_fees
}
filter income > 1
group customer_id (
  aggregate {
    average total
  }
)
sort {-sum_income}
take 10
join c=customers (==customer_id)
derive name = f"{c.last_name}, {c.first_name}"
select {
  c.customer_id, name, sum_income
}
derive db_version = s"version()"
END
