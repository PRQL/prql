use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 1;

# `pipeline` separates steps on `|` only, and a `rule` skips newlines like any
# other whitespace, so the newline-separated steps below are collected into the
# first `call-expression`'s argument list instead of becoming steps of their
# own. The shape records what the grammar builds today, not what it should.
parses-to q:to/END/, 'statement(comment),statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier))),test(test-inner(expression(identifier))),test(test-inner(binary-test(expression(identifier),compare-op,expression(date-time(date))))),test(test-inner(expression(identifier))),test(test-inner(expression(tuple-expression(declaration-tuple(identifier,expression(number(float))),declaration-tuple(identifier,expression(binary-expression(identifier,arith-op,expression(identifier)))))))),test(test-inner(expression(identifier))),test(test-inner(binary-test(expression(identifier),compare-op,expression(number(integer))))),test(test-inner(expression(identifier))),test(test-inner(expression(identifier))),test(test-inner(expression(nested-pipeline(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(call-expression(identifier,test(test-inner(expression(identifier)))))))))))))),test(test-inner(expression(identifier))),test(test-inner(expression(tuple-expression(expression(unary-expression(expression(identifier))))))),test(test-inner(expression(identifier))),test(test-inner(expression(number(integer)))),test(test-inner(expression(identifier))),declaration(identifier,expression(identifier)),test(test-inner(expression(parenthesized-expression(expression(unary-expression(identifier)))))),test(test-inner(expression(identifier))),declaration(identifier,expression(f-string)),test(test-inner(expression(identifier))),test(test-inner(expression(tuple-expression(expression(identifier),expression(identifier),expression(identifier))))),test(test-inner(expression(identifier))),declaration(identifier,expression(s-string))))))';
# Website showcasing example
from invoices
filter invoice_date >= @1970-01-16
derive {
  transaction_fees = 0.8,
  income = total - transaction_fees
}
filter income > 1
group customer_id (
  aggregate {
    average total
  }
)
sort {-sum_income}
take 10
join c=customers (==customer_id)
derive name = f"{c.last_name}, {c.first_name}"
select {
  c.customer_id, name, sum_income
}
derive db_version = s"version()"
END
