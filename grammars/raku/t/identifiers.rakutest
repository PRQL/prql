use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 3;

# Basic identifier
parses-to 'filter foo', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))))))';

# Identifier with underscore and digit
parses-to 'filter foo_123', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))))))';

# Unicode identifier
parses-to 'filter räksmörgås', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))))))';
