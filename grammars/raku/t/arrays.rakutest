use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 6;

# Array on one line
parses-to 'filter [foo, bar, baz]', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(identifier))),test(test-inner(expression(identifier))),test(test-inner(expression(identifier)))))))))))';

# Array on multiple lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(identifier))),test(test-inner(expression(identifier))),test(test-inner(expression(identifier)))))))))))';
filter [
  foo,
  bar,
  baz
]
END

# Array on multiple lines with blank lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(identifier))),test(test-inner(expression(identifier))),test(test-inner(expression(identifier)))))))))))';
filter [

  foo,

  bar,

  baz

]
END

# Array of integers
parses-to 'filter [1, 2, 3]', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(number(integer)))),test(test-inner(expression(number(integer)))),test(test-inner(expression(number(integer))))))))))))';

# Array of floats
parses-to 'filter [1.1, 2.2, 3.3]', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(number(float)))),test(test-inner(expression(number(float)))),test(test-inner(expression(number(float))))))))))))';

# Array of strings
parses-to 'filter ["string", f"format", r"raw", s"server"]', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(array-expression(test(test-inner(expression(string))),test(test-inner(expression(f-string))),test(test-inner(expression(r-string))),test(test-inner(expression(s-string)))))))))))';
