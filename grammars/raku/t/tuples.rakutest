use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 5;

# Tuple on one line
parses-to 'test {foo, bar, baz}', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(expression(identifier),expression(identifier),expression(identifier)))))))))';

# Tuple on multiple lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(expression(identifier),expression(identifier),expression(identifier)))))))))';
test {
  foo,
  bar,
  baz
}
END

# Tuple on multiple lines with blank lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(expression(identifier),expression(identifier),expression(identifier)))))))))';
test {

  foo,

  bar,

  baz

}
END

# Tuple with key and value
parses-to 'test {foo=bar}', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(declaration-tuple(identifier,expression(identifier))))))))))';

# Tuple with keys and values
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(declaration-tuple(identifier,expression(identifier)),declaration-tuple(identifier,expression(number(integer))),declaration-tuple(identifier,expression(number(float))),declaration-tuple(identifier,expression(string))))))))))';
test {identifier=identifier,int  =3, float=  3.14 ,
string    =    "string"
}
END
