use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 5;

# Tuple on one line
parses-to 'test {foo, bar, baz}', 'statement(pipeline-statement(pipeline(call-expression(identifier«test»,test(test-inner(expression(tuple-expression(expression(identifier«foo»),expression(identifier«bar»),expression(identifier«baz»)))))))))';

# Tuple on multiple lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier«test»,test(test-inner(expression(tuple-expression(expression(identifier«foo»),expression(identifier«bar»),expression(identifier«baz»)))))))))';
test {
  foo,
  bar,
  baz
}
END

# Tuple on multiple lines with blank lines
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier«test»,test(test-inner(expression(tuple-expression(expression(identifier«foo»),expression(identifier«bar»),expression(identifier«baz»)))))))))';
test {

  foo,

  bar,

  baz

}
END

# Tuple with key and value
parses-to 'test {foo=bar}', 'statement(pipeline-statement(pipeline(call-expression(identifier«test»,test(test-inner(expression(tuple-expression(declaration-tuple(identifier«foo»,expression(identifier«bar»))))))))))';

# Tuple with keys and values
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier«test»,test(test-inner(expression(tuple-expression(declaration-tuple(identifier«identifier»,expression(identifier«identifier»)),declaration-tuple(identifier«int»,expression(number(integer«3»))),declaration-tuple(identifier«float»,expression(number(float«3.14»))),declaration-tuple(identifier«string»,expression(string«"string"»))))))))))';
test {identifier=identifier,int  =3, float=  3.14 ,
string    =    "string"
}
END
