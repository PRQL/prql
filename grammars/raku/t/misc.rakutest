use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 23;

# Boolean: true
parses-to 'filter true', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(boolean)))))))';

# Boolean: false
parses-to 'filter false', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(boolean)))))))';

# Null
parses-to 'filter null', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression))))))';

# Keyword: this
parses-to 'filter this', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression))))))';

# Keyword: that
parses-to 'filter that', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression))))))';

# Annotation
parses-to q:to/END/, 'statement(annotation(declaration(identifier,expression(number(integer))))),statement(variable-declaration(variable-name,lambda(lambda-param(identifier),expression(identifier))))';
@{binding_strength=1}
let x = y -> z
END

# Range: 10..20
parses-to 'filter 10..20', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(range-expression)))))))';

# Comment
parses-to 'filter 1 # Hello', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))),comment)';

# Two comments
parses-to q:to/END/, 'statement(comment),statement(comment)';
# Hello
# Bar
END

# Comment between pipes
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))))),comment),statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))))))';
from foo
# filter...
select bar
END

# Docblock
parses-to q:to/END/, 'statement(doc-block),statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(number(integer))))))))';
#! Hello
filter 1
END

# Variable declaration
parses-to 'let foo = (from foo)', 'statement(variable-declaration(variable-name,nested-pipeline(pipeline(call-expression(identifier,test(test-inner(expression(identifier))))))))';

# Function declaration
parses-to 'let my_func = arg1 -> arg1', 'statement(variable-declaration(variable-name,lambda(lambda-param(identifier),expression(identifier))))';

# Function declaration with two args
parses-to 'let my_func = arg1 arg2 -> arg1 + arg2', 'statement(variable-declaration(variable-name,lambda(lambda-param(identifier),lambda-param(identifier),expression(binary-expression(identifier,arith-op,expression(identifier))))))';

# Function declaration with type annotation
parses-to 'let my_func = arg1<int32> -> arg1', 'statement(variable-declaration(variable-name,lambda(lambda-param(identifier,type-definition(type-name(identifier))),expression(identifier))))';

# Parameter
parses-to 'filter id == $1', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(binary-test(expression(identifier),compare-op,expression(parameter))))))))';

# Parenthesized expression
parses-to 'filter (1)', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(parenthesized-expression(expression(number(integer))))))))))';

# Simple pipeline
parses-to 'from foo | select bar', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier)))),call-expression(identifier,test(test-inner(expression(identifier)))))))';

# Derive
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(declaration-tuple(identifier,expression(number(float))),declaration-tuple(identifier,expression(binary-expression(identifier,arith-op,expression(identifier))))))))))))';
derive {
  transaction_fees = 0.8,
  income = total - transaction_fees
}
END

# Nested pipeline
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(identifier))),test(test-inner(expression(nested-pipeline(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(call-expression(identifier,test(test-inner(expression(identifier))))))))))))))))))';
group customer_id (
  aggregate {
    average total
  }
)
END

# Tabs as spaces
parses-to 'let		foo		=		(foo 1)', 'statement(variable-declaration(variable-name,nested-pipeline(pipeline(call-expression(identifier,test(test-inner(expression(number(integer)))))))))';

# Module
parses-to q:to/END/, 'statement(module(identifier,statement(variable-declaration(variable-name,lambda(expression(s-string))))))';
module foo {
  let x = -> s"foo()"
}
END

# Pipeline within tuple
parses-to q:to/END/, 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(tuple-expression(declaration-tuple(identifier,expression(nested-pipeline(pipeline(expression(identifier),identifier))))))))))))';
derive {
  a = (b | math.abs)
}
END
