use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 11;

# Single-quoted string
parses-to "filter 'Hello'", 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(string)))))))';

# Double-quoted string
parses-to 'filter "Hello"', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(string)))))))';

# Single-quoted f-string
parses-to "filter f'Hello \{name\}!'", 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(f-string)))))))';

# Double-quoted f-string
parses-to 'filter f"Hello {name}!"', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(f-string)))))))';

# Single-quoted r-string
parses-to "filter r'version()'", 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(r-string)))))))';

# Double-quoted r-string
parses-to 'filter r"version()"', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(r-string)))))))';

# Single-quoted s-string
parses-to "filter s'version()'", 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(s-string)))))))';

# Double-quoted s-string
parses-to 'filter s"version()"', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(s-string)))))))';

# Triple-quoted single-quoted string
parses-to "filter '''Hello world!'''", 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(string)))))))';

# Triple-quoted double-quoted string
parses-to 'filter """Hello world!"""', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(string)))))))';

# Escape sequence
parses-to 'filter "\xff"', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(string(escape(xdigit,xdigit)))))))))';
