use Test;
use prql;

plan 19;

# Single-quoted string
ok PRQL.parse("filter 'Hello'");
#query(pipeline(call-expression(identifier,arg-list(string))))

# Double-quoted string
ok PRQL.parse('filter "Hello"');
#query(pipeline(call-expression(identifier,arg-list(string))))

# Single-quoted f-string
ok PRQL.parse("filter f'Hello \{name\}!'");
#query(pipeline(call-expression(identifier,arg-list(f-string))))

# Double-quoted f-string
ok PRQL.parse('filter f"Hello {name}!"');
#query(pipeline(call-expression(identifier,arg-list(f-string))))

# Single-quoted r-string
ok PRQL.parse("filter r'version()'");
#query(pipeline(call-expression(identifier,arg-list(r-string))))

# Double-quoted r-string
ok PRQL.parse('filter r"version()"');
#query(pipeline(call-expression(identifier,arg-list(r-string))))

# Single-quoted s-string
ok PRQL.parse("filter s'version()'");
#query(pipeline(call-expression(identifier,arg-list(s-string))))

# Double-quoted s-string
ok PRQL.parse('filter s"version()"');
#query(pipeline(call-expression(identifier,arg-list(s-string))))

# Triple-quoted single-quoted string
ok PRQL.parse("filter '''Hello world!'''");
#query(pipeline(call-expression(identifier,arg-list(string))))

# Triple-quoted double-quoted string
ok PRQL.parse('filter """Hello world!"""');
#query(pipeline(call-expression(identifier,arg-list(string))))

# Escape sequence
ok PRQL.parse('filter "\xff"');
#query(pipeline(call-expression(identifier,arg-list(string(escape)))))

# Triple-quoted double-quoted string containing the quote character
ok PRQL.parse('filter """I said "hello world"!"""');

# Triple-quoted single-quoted string containing the quote character
ok PRQL.parse("filter '''I said 'hello world'!'''");

# Escaped double quote within a double-quoted string
ok PRQL.parse('filter "\"hello world\""');

# Escaped backslash within a double-quoted string
ok PRQL.parse('filter "C:\\\\path"');

# Escaped double quote within an f-string
ok PRQL.parse('filter f"\"hello world\""');

# Escaped double quote within an s-string
ok PRQL.parse('filter s"\"hello world\""');

# Unrecognized escape sequence: the compiler keeps the character after the
# backslash rather than rejecting the string, so the grammar accepts any
# character there too
ok PRQL.parse('filter "\d+"');

# Unrecognized escape sequence within an s-string, as a SQL regex would use
ok PRQL.parse('filter s"x ~ \'\\d+\'"');
