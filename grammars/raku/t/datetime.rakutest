use Test;
use lib $?FILE.IO.parent.add('lib').Str;
use PRQLTest;

plan 7;

# Date YYYY-MM-DD
parses-to 'filter @1970-01-01', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(date))))))))';

# Time HH:MM
parses-to 'filter @08:30', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(time))))))))';

# Time HH:MM:SS
parses-to 'filter @12:00:00', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(time))))))))';

# Time HH:MM:SS.xxx
parses-to 'filter @12:00:00.500', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(time))))))))';

# Date and time
parses-to 'filter @1970-01-01T12:00:00', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(date,time))))))))';

# Date and time with timezone
parses-to 'filter @1970-01-01T12:00:00+01:00', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(date,time))))))))';

# Date and time in UTC
parses-to 'filter @1970-01-01T12:00:00Z', 'statement(pipeline-statement(pipeline(call-expression(identifier,test(test-inner(expression(date-time(date,time))))))))';
